# SmartMeet Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED: MongoDB Configuration
# ============================================
# Get a free MongoDB Atlas cluster at: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smartmeet?retryWrites=true&w=majority

# ============================================
# REQUIRED: Gemini AI Configuration
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Additional API keys for fallback (rate limiting)
# GEMINI_API2=your_second_api_key
# GEMINI_API3=your_third_api_key

# ============================================
# REQUIRED: Google OAuth Configuration (Passport.js + OAuth2 Flow)
# ============================================
# Get credentials from: https://console.cloud.google.com/
# Create OAuth 2.0 Web Application credentials
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Must match authorized redirect URI in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ============================================
# Optional: Frontend URL (for CORS and OAuth redirects)
# ============================================
# In production, set this to your Vercel frontend URL
# Example: https://smartmeet.vercel.app
FRONTEND_URL=http://localhost:3000

# ============================================
# Session & JWT Configuration
# ============================================
# Use minimum 32 characters for production
JWT_SECRET=your_long_secure_jwt_secret_min_32_chars_for_production
SESSION_SECRET=your_long_secure_session_secret_min_32_chars_for_production

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# Optional: CORS Origins (comma-separated)
# ============================================
# Production example: https://smartmeet.vercel.app,https://app.smartmeet.com
ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# Optional: TURN Relay Configuration (for NAT traversal)
# ============================================
# Use Metered TURN servers or configure your own
METERED_TURN_USERNAME=your_metered_turn_username
METERED_TURN_CREDENTIAL=your_metered_turn_credential
# Or use custom TURN servers:
# TURN_URLS=turn:your-turn-server.com:3478,turns:your-turn-server.com:5349
# TURN_USERNAME=your_turn_username
# TURN_CREDENTIAL=your_turn_credential
NODE_ENV=development
HOST=0.0.0.0

# ============================================
# CORS Configuration (Production)
# ============================================
# Comma-separated list of allowed origins
# Example: ALLOWED_ORIGINS=https://your-frontend.com,https://app.yourdomain.com
# Leave empty to allow all origins (not recommended for production)
# ALLOWED_ORIGINS=

# ============================================
# WebRTC TURN Configuration - Metered.ca (Recommended)
# ============================================
# Metered.ca credentials from your Metered dashboard
# You can keep URLs empty to use sensible Metered defaults in code.
# Comma-separated TURN URLs (include UDP and TCP variants when possible)
# Example:
# METERED_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# METERED_TURN_USERNAME=your_metered_username
# METERED_TURN_CREDENTIAL=your_metered_password
# If not set, only public STUN will be used (less reliable across strict NAT/firewalls)
# METERED_TURN_URLS=
# METERED_TURN_USERNAME=
# METERED_TURN_CREDENTIAL=

# Backward-compatible generic names (optional alternative)
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=
